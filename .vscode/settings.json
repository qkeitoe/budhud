{
    "editor.detectIndentation": true,
    "files.insertFinalNewline": false,
    "[vdf]": {
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "pfwobcke.vscode-budhud-formatter"
    },
    "[vmt]": {
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "pfwobcke.vscode-budhud-formatter"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "files.associations": {
        "bh_animate_*.txt": "hudanimations",
        "bh_spy_hidedisguiseicon.txt": "hudanimations",
        "bh_medic_rainbowcharge.txt": "hudanimations",
        "*valve.rc": "cfg"
    },
    "editor.rulers": [
        68
    ],
    "vscode-vdf.vdf.format.insertNewlineBeforeObjects": true
}